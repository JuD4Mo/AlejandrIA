# Copiar a .env y reemplazar antes de iniciar; este valor no es una credencial real.
POSTGRES_DB=alejandria
POSTGRES_USER=alejandria
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
BACKEND_PORT=8080
# Reemplazar por un secreto aleatorio (32 bytes o más); no usar en producción.
APP_AUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes
APP_RECOMMENDATION_TIMEOUT=8s
APP_RECOMMENDATION_URL=http://recommendations:8000
RECOMMENDER_MEMORY_LIMIT=8g
# Solo con compose.dev.yaml
RECOMMENDER_PORT=8000
